    <div class="py-3 px-5 bg-black shadow-xl position-relative">
        <div class="container">
            <div class="-mx-1">
                <ul class="flex w-full flex-wrap items-center h-10">
                    <li class="block relative">
                        <!-- // TODO: put bg-amber-500 class -->
                        <a bg-blackclass="flex items-center h-10 leading-10 px-4 rounded cursor-pointer no-underline hover:no-underline transition-colors duration-100 mx-1 text-white">
                            <span class="mr-3 text-xl"> <i class="mdi mdi-gauge"></i> </span>
                            <span>Home</span>
                            <span class="ml-2"> <i class="mdi mdi-chevron-down"></i> </span>
                        </a>
                    </li>

                    <li class="block relative">
                        <a
                            bg-blackclass="flex items-center h-10 leading-10 px-4 rounded cursor-pointer no-underline hover:no-underline transition-colors duration-100 mx-1 text-white"
                            @click="toggleOn('news')"
                            v-click-outside="toggleOff('news')"
                        >
                            <span class="mr-3 text-xl"> <i class="mdi mdi-gauge"></i> </span>
                            <span>News</span>
                            <span class="ml-2"> <i class="mdi mdi-chevron-down"></i> </span>
                        </a>
                        <div class="bg-black shadow-md rounded border border-gray-300 text-sm absolute top-auto left-0 min-w-full w-56 z-30 mt-1" v-if="isToggled('news')">
                            <span class="absolute top-0 left-0 w-3 h-3 bg-black border transform rotate-45 -mt-1 ml-6"></span>
                            <div class="bg-black rounded w-full relative z-10 py-1">
                                <ul class="list-reset">
                                    {{#each data}}
                                    {{#ifEquals this.parent 'News'}}
                                    <li class="relative">
                                        <a 
                                            href="{{ this.link }}"
                                            bg-blackclass="px-4 py-2 flex w-full items-start hover:bg-gray-100 no-underline hover:no-underline transition-colors duration-100 cursor-pointer"
                                        >
                                            <span class="flex-1">{{ this.label }}</span>
                                        </a>
                                    </li>
                                    {{/ifEquals}}
                                    {{/each}}
                                </ul>
                            </div>
                        </div>
                    </li>

                </ul>
            </div>
        </div>
    </div>