<div class="menu-bar relative">
  <div class="container">
    <div class="-mx-1">
      <div class="burger">
        <a class="button cursor-pointer medium primary" @click="isToggled('menu-opened') ? toggleOff('menu-opened') : toggleOn('menu-opened')">
          <i class="fa-solid fa-bars"></i>
        </a>
      </div>

      <ul :class="{ menu: true, opened: isToggled('menu-opened') }">
        <li class="block relative">
          <div class="menu-item">
            <a class="cursor-pointer" href="/">
              <span>{{{__ 'home'}}}</span>
            </a>
          </div>
        </li>

        <li class="block relative">
          <div class="menu-item">
            <a class="cursor-pointer" @click="toggleOn('News')" v-click-outside="toggleOff('News')">
              <span>{{{__ 'news'}}}</span>
              <span class="ml-4 text-neutral-500">
                <i class="fa-solid fa-chevron-down"></i>
              </span>
            </a>
            <div class="submenu" v-if="isToggled('News')">
              <ul class="submenu-list">
                {{#each data}}
                  {{#ifEquals this.parent 'News'}}
                    <li>
                      <a class="submenu-item" href="{{this.link}}">{{this.label}}</a>
                    </li>
                  {{/ifEquals}}
                {{/each}}
              </ul>
            </div>
          </div>
        </li>

        <li class="block relative">
          <div class="menu-item">
            <a class="cursor-pointer" @click="toggleOn('Play')" v-click-outside="toggleOff('Play')">
              <span>{{{__ 'play'}}}</span>
              <span class="ml-4 text-neutral-500">
                <i class="fa-solid fa-chevron-down"></i>
              </span>
            </a>
            <div class="submenu" v-if="isToggled('Play')">
              <ul class="submenu-list">
                {{#each data}}
                  {{#ifEquals this.parent 'Play'}}
                    <li>
                      <a class="submenu-item" href="{{this.link}}">{{this.label}}</a>
                    </li>
                  {{/ifEquals}}
                {{/each}}
              </ul>
            </div>
          </div>
        </li>

        <li class="block relative">
          <div class="menu-item">
            <a class="cursor-pointer" @click="toggleOn('About')" v-click-outside="toggleOff('About')">
              <span>{{{__ 'about'}}}</span>
              <span class="ml-4 text-neutral-500">
                <i class="fa-solid fa-chevron-down"></i>
              </span>
            </a>
            <div class="submenu" v-if="isToggled('About')">
              <ul class="submenu-list">
                {{#each data}}
                  {{#ifEquals this.parent 'About'}}
                    <li>
                      <a class="submenu-item" href="{{this.link}}">{{this.label}}</a>
                    </li>
                  {{/ifEquals}}
                {{/each}}
              </ul>
            </div>
          </div>
        </li>

        <li class="block login">
          <a class="cursor-pointer" href="/login">
            <div class="login-content">
              <img class="mr-4" src="/menu-login.png" />
              <span>{{{__ 'login'}}}</span>
            </div>
          </a>
        </li>

      </ul>
    </div>
  </div>
</div>