{{#if button1}}
  <a class="
    button
    {{#ifEquals button1.style 'Primary'}}
      primary
    {{/ifEquals}}
    {{#ifEquals button1.style 'Warning'}}
      warning
    {{/ifEquals}}
    {{#ifEquals button1.style 'Danger'}}
      danger
    {{/ifEquals}}
    {{#ifEquals button1.size 'Small'}}
      small
    {{/ifEquals}}
    {{#ifEquals button1.size 'Medium'}}
      medium
    {{/ifEquals}}
    {{#ifEquals button1.size 'Big'}}
      big
    {{/ifEquals}}
    "
    {{#if button1.openInNewTab}}
      target="_blank"
    {{/if}}
    href="{{ button1.link }}"
  >
    {{#if button1.icon}}
      <i class="fa-solid {{ button1.icon }}"></i>
    {{/if}}
    {{ button1.label }}
  </a>
{{/if}}

