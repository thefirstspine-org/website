<div class="quote">
  <figure class="max-w-screen-md mx-auto text-center">
    <i class="fa-solid fa-quote-left text-amber-500 text-4xl"></i>
    <blockquote>
        <p class="text-2xl italic font-medium text-gray-900 dark:text-white">{{ body }}</p>
    </blockquote>
    <figcaption class="flex items-center justify-center mt-6 space-x-3 rtl:space-x-reverse">
        <div class="flex items-center divide-x-2 rtl:divide-x-reverse divide-gray-500 dark:divide-gray-700">
            <cite class="font-medium text-gray-900 dark:text-white">{{ title }}</cite>
        </div>
    </figcaption>
</figure>
</div>