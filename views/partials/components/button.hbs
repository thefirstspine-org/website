  <a class="
    button
    {{#ifEquals style 'Primary'}}
      primary
    {{/ifEquals}}
    {{#ifEquals style 'Warning'}}
      warning
    {{/ifEquals}}
    {{#ifEquals style 'Danger'}}
      danger
    {{/ifEquals}}
    {{#ifEquals size 'Small'}}
      small
    {{/ifEquals}}
    {{#ifEquals size 'Medium'}}
      medium
    {{/ifEquals}}
    {{#ifEquals size 'Big'}}
      big
    {{/ifEquals}}
    "
    {{#if openInNewTab}}
      target="_blank"
    {{/if}}
    href="{{ link }}"
  >
    {{#if icon}}
      <i class="fa-solid {{ icon }}"></i>
    {{/if}}
    {{ label }}
  </a>