{{#if data.errors}}
  <div
    v-if="!isToggled('close-toast-error')" 
    class="flex items-center w-full max-w-lg p-4 bg-red-950 text-red-300 rounded-lg shadow-sm mt-30 mb-4 mx-auto "
    role="alert">
    <div class="inline-flex items-center justify-center shrink-0 w-16 h-16 text-red-400 bg-red-900 rounded-lg text-2xl">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div class="ms-4">
      {{#each data.errors}}
        <p>{{{__ this}}}</p>
      {{/each}}
    </div>
    <button @click="toggleOn('close-toast-error')" type="button" class="ms-auto -mx-1.5 -my-1.5 text-red-400 hover:text-red-900 rounded-lg focus:ring-2 focus:ring-red-300 p-1.5 hover:bg-red-100 inline-flex items-center justify-center h-8 w-8" aria-label="Close">
        <span class="sr-only">Close</span>
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
    </button>
  </div>
{{/if}}

<div
  class="components-block">
  <div class="container">
    <h1 class="text-4xl md:text-6xl text-center mt-4 text-amber-500 tracking-widest uppercase">
      {{{__ 'login'}}}
    </h1>
    <form class="max-w-md mx-auto" method="post" action="/login?redirect={{data.redirect}}">
      <p class="mt-8">{{{__ 'email address'}}}</p>
      <input type="email" name="email" class="input mt-2" placeholder="{{{__ 'me@email.com'}}}" />
      <p class="mt-8">{{{__ 'password'}}}</p>
      <input type="password" name="password" class="input mt-2" placeholder="{{{__ '*****'}}}" />
      <p class="mt-8 text-center">
        <input type="submit" class="button medium primary cursor-pointer" value="{{__ 'submit'}}" />
      </p>
      <p class="mt-16 text-center">
        <a href="/register?redirect={{data.redirect}}" class="text-amber-300 hover:text-amber-500 transition-colors duration-500 font-bold">
          {{{__ 'create an account'}}}
        </a>
      </p>
      <p class="mt-2 text-center">
        <a href="/lost-password?redirect={{data.redirect}}" class="text-amber-300 hover:text-amber-500 transition-colors duration-500 font-bold">
          {{{__ 'lost password'}}}
        </a>
      </p>
    </form>
  </div>
</div>