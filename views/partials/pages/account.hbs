<div
  class="components-block">
  <h1 class="text-6xl mt-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
    {{{__ 'your wizard account'}}}
  </h1>
</div>

<div
  class="components-block"
  >
  <div class="separator"></div>
  <div class="container">
    <div class="my-8 text-center">
      <h1 class="text-4xl mt-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
        {{{__ 'your account information'}}}
      </h1>
      <p class="mt-8">
        {{{__ 'here you can manage your account and update your information'}}}
      </p>
    </div>
  </div>
</div>

<div
  class="components-block"
  >
  <div class="separator"></div>
  <div class="container">
    <div class="my-8 text-center">
      <h1 class="text-4xl mt-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
        {{{__ 'your account on arena'}}}
      </h1>
      {{#if data.arenaPlayer}}
        <p class="mt-8">{{{__ 'your player name is'}}} <strong>{{data.arenaPlayer.name}}</strong></p>
        <table class="table-auto text-left w-sm mx-auto mt-8">
          <tbody>
            <tr>
              <td class="font-bold">{{{__ 'power'}}}</td>
              <td>{{data.arenaPlayer.power}}</td>
            </tr>
            <tr>
              <td class="font-bold">{{{__ 'ancientShards'}}}</td>
              <td>{{data.arenaPlayer.currencies.ancientShards}}</td>
            </tr>
            <tr>
              <td class="font-bold">{{{__ 'destinyMarks'}}}</td>
              <td>{{data.arenaPlayer.currencies.destinyMarks}}</td>
            </tr>
            <tr>
              <td class="font-bold">{{{__ 'strangeCoins'}}}</td>
              <td>{{data.arenaPlayer.currencies.strangeCoins}}</td>
            </tr>
          </tbody>
        </table>
        <p class="mt-8">
          <a href="/arena" class="button medium primary">{{{__ 'manage your account on arena'}}}</a>
        </p>
      {{else}}
        <p class="mt-8">{{{__ 'you do not have any account on arena'}}}</p>
        <p class="mt-8">
          <a href="/arena" class="button medium primary">{{{__ 'play on arena now'}}}</a>
        </p>
      {{/if}}
    </div>
  </div>
</div>

<div
  class="components-block"
  >
  <div class="separator"></div>
  <div class="container">
    <div class="my-8 text-center">
      <h1 class="text-4xl mt-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
        {{{__ 'your information about the festivals'}}}
      </h1>
      <p class="mt-8">
        TODO
      </p>
    </div>
  </div>
</div>
