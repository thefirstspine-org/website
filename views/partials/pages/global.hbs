{{#if data.title}}
  <h1 class="text-6xl mt-8 text-center text-amber-500 tracking-widest uppercase">
    {{ data.title }}
  </h1>
{{/if}}

{{#each data.blocks}}
  <div
    class="block"
    {{#if this.background.formats.medium }}
      style="background-image: url('https://dev.cms.thefirstspine.fr/{{ this.background.formats.medium.url }}');"
    {{else if this.background.formats.small }}
      style="background-image: url('https://dev.cms.thefirstspine.fr/{{ this.background.formats.small.url }}');"
    {{/if}}
  >
    <div class="separator"></div>
    <div class="container max-w-7xl">
      {{#if this.showTitle}}
        <h1 class="text-4xl mt-16 mb-8 text-center text-amber-500 tracking-widest uppercase">
          {{ this.title }}
        </h1>
      {{/if}}
      {{#if this.image }}
        <img
          class="mx-auto my-8 rounded-lg shadow-lg"
          src="https://dev.cms.thefirstspine.fr/{{ this.image.formats.medium.url }}"
          alt="{{ this.image.alternativeText }}"
        >
      {{/if}}
      {{#each this.content}}
        {{#ifEquals this.__component 'shared.rich-text'}}
          {{> components/richtext this }}
        {{/ifEquals}}
        {{#ifEquals this.__component 'shared.button'}}
          {{> components/button this }}
        {{/ifEquals}}
      {{/each}}
    </div>
  </div>
{{/each}}

