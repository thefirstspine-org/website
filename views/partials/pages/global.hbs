{{#if data.title}}
  <div
    class="components-block">
    <h1 class="text-6xl mt-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
      {{ data.title }}
    </h1>
  </div>
{{/if}}

{{#if data.errors}}
  <div
    v-if="!isToggled('close-toast-error')" 
    class="flex items-center w-full max-w-lg p-4 bg-red-950 text-red-300 rounded-lg shadow-sm mt-30 mb-4 mx-auto "
    role="alert">
    <div class="inline-flex items-center justify-center shrink-0 w-16 h-16 text-red-400 bg-red-900 rounded-lg text-2xl">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div class="ms-4">
      {{#each data.errors}}
        <p>{{{i18n this}}}</p>
      {{/each}}
    </div>
    <button @click="toggleOn('close-toast-error')" type="button" class="ms-auto -mx-1.5 -my-1.5 text-red-400 hover:text-red-900 rounded-lg focus:ring-2 focus:ring-red-300 p-1.5 hover:bg-red-100 inline-flex items-center justify-center h-8 w-8" aria-label="Close">
        <span class="sr-only">Close</span>
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
    </button>
  </div>
{{/if}}

{{#if data.success}}
  <div
    v-if="!isToggled('close-toast-success')" 
    class="flex items-center w-full max-w-lg p-4 bg-green-950 text-green-300 rounded-lg shadow-sm mt-30 mb-4 mx-auto "
    role="alert">
    <div class="inline-flex items-center justify-center shrink-0 w-16 h-16 text-green-400 bg-green-900 rounded-lg text-2xl">
        <i class="fa-solid fa-check"></i>
    </div>
    <div class="ms-4">
        <p>{{{i18n data.success}}}</p>
    </div>
    <button @click="toggleOn('close-toast-success')" type="button" class="ms-auto -mx-1.5 -my-1.5 text-green-400 hover:text-green-900 rounded-lg focus:ring-2 focus:ring-green-300 p-1.5 hover:bg-green-100 inline-flex items-center justify-center h-8 w-8" aria-label="Close">
        <span class="sr-only">Close</span>
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
    </button>
  </div>
{{/if}}

{{#each data.blocks}}
  <div
    class="components-block"
    {{#if this.background.url }}
      style="background-image: url('{{{env 'CMS_URL' }}}{{ this.background.url }}');"
    {{/if}}
  >
    <div class="separator"></div>
    <div class="container">
      {{#if this.showTitle}}
        <h1 class="text-4xl mt-16 mb-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
          {{ this.title }}
        </h1>
      {{/if}}
      {{#if this.image }}
        <img
          class="mx-auto my-8 rounded-lg"
          src="{{{env 'CMS_URL' }}}{{ this.image.url }}"
          alt="{{ this.image.alternativeText }}"
        >
      {{/if}}
      {{#each this.content}}
        <div class="my-8 text-center">
          {{#ifEquals this.__component 'shared.rich-text'}}
            {{> components/richtext this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.button'}}
            {{> components/button this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.spacer'}}
            {{> components/spacer this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.video'}}
            {{> components/video this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.buttons-bar'}}
            {{> components/buttonsbar this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.media'}}
            {{> components/media this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.quote'}}
            {{> components/quote this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.video-gallery'}}
            {{> components/videogallery this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.slider'}}
            {{> components/slider this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.card'}}
            {{> components/card this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.email-form'}}
            {{> components/emailform this }}
          {{/ifEquals}}
          {{#ifEquals this.__component 'shared.code-form'}}
            {{> components/codeform this }}
          {{/ifEquals}}
        </div>
      {{/each}}
    </div>
  </div>
{{/each}}
