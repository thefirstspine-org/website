<div
  class="components-block">
  <h1 class="text-6xl mt-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
    Blog
  </h1>
</div>

{{#if data.featuredArticle}}
<div
  class="components-block"
  >
  <div class="separator"></div>
  <div class="container">
    <h1 class="text-4xl mt-16 mb-8 text-center text-amber-500 tracking-widest uppercase text-shadow-lg">
      {{{__ 'featured post'}}}<br />
      {{ data.featuredArticle.title }}
    </h1>
    <div class="my-8 text-center">
      {{ data.featuredArticle.description }}
    </div>
    <div class="mt-8 text-center">
      <a class="button primary big m-0" href="/blog/{{ data.featuredArticle.slug }}">
        Read more
      </a>
    </div>
  </div>
</div>
{{/if}}

<div class="components-block">
  <div class="separator"></div>
  <div class="container">
    <div class="m-auto grid grid-cols-1 gap-8 md:grid-cols-3 lg:grid-cols-3 mt-16">
      {{#each data.articles}}
      <div class="border-2 border-solid border-neutral-950 p-8">
        <h3 class="text-xl mb-4 text-center text-amber-500 tracking-widest uppercase text-shadow-lg h-16">
          {{ this.title }}
        </h3>
        <div class="article-cover mb-4" style="background-image: url('{{{env 'CMS_URL' }}}{{ this.cover.url }}');"></div>
        <p class="mb-4 h-auto md:h-33 md:overflow-hidden">
          {{ this.description }}
        </p>
        <p class="text-center mb-4">
          <a class="button primary medium m-0" href="/blog/{{ this.slug }}">{{{__ 'read more'}}}</a>
        </p>
        <p class="text-center pt-4 text-sm border-t-1 border-solid border-neutral-950">
          {{{__ 'posted in'}}}<br />
          <a class="button info tiny m-0" href="/blog?category={{ this.category.slug }}">#{{ this.category.name }}</a>
        </p>
      </div>
      {{/each}}
    </div>
  </div>
</div>
