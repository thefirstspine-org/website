{{#if data.errors}}
  <div
    v-if="!isToggled('close-toast-error')" 
    class="flex items-center w-full max-w-lg p-4 bg-red-950 text-red-300 rounded-lg shadow-sm mt-30 mb-4 mx-auto "
    role="alert">
    <div class="inline-flex items-center justify-center shrink-0 w-16 h-16 text-red-400 bg-red-900 rounded-lg text-2xl">
        <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    <div class="ms-4">
      {{#each data.errors}}
        <p>{{{__ this}}}</p>
      {{/each}}
    </div>
    <button @click="toggleOn('close-toast-error')" type="button" class="ms-auto -mx-1.5 -my-1.5 text-red-400 hover:text-red-900 rounded-lg focus:ring-2 focus:ring-red-300 p-1.5 hover:bg-red-100 inline-flex items-center justify-center h-8 w-8" aria-label="Close">
        <span class="sr-only">Close</span>
        <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
        </svg>
    </button>
  </div>
{{/if}}

<div
  class="components-block">
  <div class="content">
    {{#if data.code}}
      <h1 class="text-4xl md:text-6xl text-center mt-4 mb-16 text-amber-500 tracking-widest uppercase">
        {{{__ 'this code has been redeemed'}}}
      </h1>
      <div class="text-center">
        <p class="mb-8 mt-4 text-2xl">
          {{{__ 'this code was obtained from the event'}}} <strong>{{ data.code.event.title }}</strong>
        </p>
        <p class="mb-8 text-2xl">
          {{{__ 'it contains the following rewards'}}}
        </p>
        {{#if data.code.arena_destinyMarks}}
          <p class="mb-8">
            <img src="/destiny-marks.png" class="inline-block" /><br />
            {{{__ 'arena_destinyMarks'}}} <strong>{{ data.code.arena_destinyMarks }}</strong><br />
            <span class="text-sm">{{{__ 'arena_destinyMarks_description'}}}</span>
          </p>
        {{/if}}
        {{#if data.code.arena_ancientShards}}
          <p class="mb-8">
            <img src="/ancient-shards.png" class="inline-block" /><br />
            {{{__ 'arena_ancientShards'}}} <strong>{{ data.code.arena_ancientShards }}</strong><br />
            <span class="text-sm">{{{__ 'arena_ancientShards_description'}}}</span>
          </p>
        {{/if}}
        {{#if data.code.kickstarter_strangeCoins}}
          <p class="mb-8">
            <img src="/strange-coins.png" class="inline-block" /><br />
            {{{__ 'kickstarter_strangeCoins'}}} <strong>{{ data.code.kickstarter_strangeCoins }}</strong><br />
            <span class="text-sm">{{{__ 'kickstarter_strangeCoins_description'}}}</span>
          </p>
        {{/if}}
        <p class="mb-8 text-2xl">
          {{{__ 'the reward was added to your account'}}}
        </p>
      </div>
    {{else}}
      <div class="my-8 text-center">
        <h1 class="text-4xl md:text-6xl text-center mt-4 mb-16 text-amber-500 tracking-widest uppercase">
          {{{__ 'enter your code'}}}
        </h1>
        <p class="mb-4 text-2xl">
          {{{__ 'enter your code in the form below to claim your reward'}}}
        </p>
        {{> 'components/codeform'}}
      </div>
    {{/if}}
  </div>
</div>