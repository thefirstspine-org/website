<!DOCTYPE html>
<html>
  <head>
    <title>{{ seo.metaTitle }} - {{ templateData.siteName }}</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta property="og:type" content="website" />
    <meta property="og:title" content="{{ seo.metaTitle }} - {{ templateData.siteName }}" />
    <meta property="og:description" content="{{ seo.metaDescription }}" />
    <meta property="og:image" content="{{{env 'CMS_URL' }}}{{ seo.shareImage.url }}" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link href="/main.css" rel="stylesheet">
  </head>
<body>

  <main id="app" v-scope="app">
    <div>
      {{> menu data=templateData.navigation }}
      <div class="main-content">
        {{> (lookup . 'page') data=pageData }}
        <div
          class="components-block">
          <div class="separator"></div>
          <div class="container my-8">
            <div class="m-auto grid grid-cols-1 gap-4 md:grid-cols-3 lg:grid-cols-3">
              <div class="mt-8">
                <h5 class="text-xl mb-4 text-amber-500">{{{__ 'we are social'}}}</h5>
                <a href="https://fb.com/thefirstspine" target="_blank" class="button small primary facebook">
                  <i class="fab fa-facebook-square"></i>
                </a>
                <a href="https://www.youtube.com/channel/UCW2snzxKIZd76fWQ55FgVyQ" target="_blank" class="button small primary youtube">
                  <i class="fab fa-youtube-square"></i>
                </a>
                <a href="https://twitter.com/TheFirstSpine" target="_blank" class="button small primary twitter">
                  <i class="fab fa-twitter"></i>
                </a>
                <a href="https://discord.gg/7DWtSw8hn6" target="_blank" class="button small primary discord">
                  <i class="fab fa-discord"></i>
                </a>
              </div>
              <div class="mt-8">
                <h5 class="text-xl mb-4 text-amber-500">{{{__ 'news'}}}</h5>
                {{#each templateData.navigation}}
                  {{#ifEquals this.parent 'News'}}
                  <p class="text-sm">
                    <a href="{{this.link}}">{{this.label}}</a>
                  </p>
                  {{/ifEquals}}
                {{/each}}
                <h5 class="text-xl my-4 text-amber-500">{{{__ 'play'}}}</h5>
                {{#each templateData.navigation}}
                  {{#ifEquals this.parent 'Play'}}
                  <p class="text-sm">
                    <a href="{{this.link}}">{{this.label}}</a>
                  </p>
                  {{/ifEquals}}
                {{/each}}
              </div>
              <div class="mt-8">
                <h5 class="text-xl mb-4 text-amber-500">{{{__ 'about'}}}</h5>
                {{#each templateData.navigation}}
                  {{#ifEquals this.parent 'About'}}
                  <p class="text-sm">
                    <a href="{{this.link}}">{{this.label}}</a>
                  </p>
                  {{/ifEquals}}
                {{/each}}
                <h5 class="text-xl my-4 text-amber-500">{{{__ 'other languages'}}}</h5>
                <p>
                  <a href="/lang/fr">
                    <img src="/fr.png" class="inline-block" />
                  </a> <a href="/lang/en">
                    <img src="/us.png" class="inline-block" />
                  </a>
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <template id="card-template">
    <div class="card-template">
      <div class="loading" v-if="!card">{{{__ 'loading card'}}}</div>
      <div :class="`card card-${template}`" v-if="card">
        <div :class="{
          foreground: true,
          creature: card.type == 'creature',
          artifact: card.type == 'artifact',
          spell: card.type == 'spell',
          player: card.type == 'player',
        }"></div>
        <div
          class="background"
          :style="{backgroundUrl: `url(${card.imageUrl})`}"
          ></div>
        <span class="top-str">\{{ card.stats.top.strength }}</span>
        <span class="top-def">\{{ card.stats.top.defense }}</span>
        <span class="top-capacity">
          <img :src="`capacity-${card.stats.top.capacity}.png`" />
        </span>
        <span class="bottom-str">\{{ card.stats.bottom.strength }}</span>
        <span class="bottom-def">\{{ card.stats.bottom.defense }}</span>
        <span class="bottom-capacity">
          <img :src="`capacity-${card.stats.bottom.capacity}.png`" />
        </span>
        <span class="left-str">\{{ card.stats.left.strength }}</span>
        <span class="left-def">\{{ card.stats.left.defense }}</span>
        <span class="left-capacity">
          <img :src="`capacity-${card.stats.left.capacity}.png`" />
        </span>
        <span class="right-str">\{{ card.stats.right.strength }}</span>
        <span class="right-def">\{{ card.stats.right.defense }}</span>
        <span class="right-capacity">
          <img :src="`capacity-${card.stats.right.capacity}.png`" />
        </span>
        <span class="life">\{{ card.stats.life }}</span>
        <span class="capacity">
          <img :src="`capacity-${card.stats.capacity}.png`" />
        </span>
        <span class="life">\{{ card.stats.life }}</span>
        <span class="capacity">
          <img :src="`capacity-${(card.stats.capacities ? card.stats.capacities[0] : '')}.png`" />
        </span>
        <span class="name">\{{ card.name.en }}</span>
        <span class="description">\{{ card.text.en }}</span>
      </div>
    </div>
  </template>

  <script src="/bundle.js" defer></script>
</body>
</html>